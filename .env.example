# Copy to .env and fill with real values (do NOT commit .env)

# Cloudflare Worker base URL used by the About page
VITE_API_BASE=https://your-worker.your-subdomain.workers.dev

# Shared secret between Cloudflare Worker (/generate_code) and the Electron app (license.ts)
LICENSE_SECRET=change-this-to-a-long-random-secret
